# Telegram: use webhook on HF; use `python bot.py` for local polling (not both).
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=5231453921
# Required on Space: random secret >=16 chars, e.g. `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=
# HF supplies SPACE_HOST automatically. Override only for a custom HTTPS domain:
# PUBLIC_BASE_URL=https://your-user-your-space.hf.space

# Attach an HF Storage Bucket/Volume at /data, then set these two values.
# A writable folder alone does NOT guarantee persistence.
# On Space, attach a Storage Bucket/Volume at /data, then uncomment:
# ENGLISHAWY_DATA=/data/englishawy
# ENGLISHAWY_PERSISTENT_STORAGE=1

# Local-only polling against your own Telegram Local Bot API server:
# TELEGRAM_LOCAL_API=1
# TELEGRAM_API_BASE_URL=http://127.0.0.1:8081/bot

# Recognition
MAX_RESULTS=5
RERANK_CANDIDATES=30
FONT_LIMIT=0
DINOV2_THREADS=4
# ENGLISHAWY_CACHE=/path/to/ephemeral/cache
# DINOV2_ONNX_PATH=/path/to/custom/dinov2.onnx
# TESSDATA_PREFIX=/path/to/tessdata

# Space startup downloads public Google fonts in the background.
ENGLISHAWY_AUTO_SETUP=1
ASSET_WORKERS=12
# Optional GitHub token for asset-download rate limits; never expose to browser.
# GH_TOKEN=
