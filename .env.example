# توكن البوت من @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

# مفتاح API من حسابك على whatfontis.com
WHATFONTIS_API_KEY=PUT_YOUR_WHATFONTIS_API_KEY_HERE

# رابط السيرفر الخارجي لتخزين الخطوط (External Font Storage Server / CDN)
EXTERNAL_FONT_SERVER_URL=https://cdn.englishawy-fonts.io/vault/v2

# عدد النتائج المرجعة لكل صورة (1-20)
MAX_RESULTS=5
