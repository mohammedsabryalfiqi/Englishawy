# توكن البوت من @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

# عدد الخطوط في بطاقة المقارنة (الافتراضي 5 مثل المثال)
MAX_RESULTS=5

# عدد المرشحين الذين يعيد DINOv2 ترتيبهم عصبياً (الافتراضي 30)
RERANK_CANDIDATES=30

# حدّ اختياري لعدد خطوط Google التي تُفحص (0 = كل المكتبة ~1800). قلّله لتسريع الرد.
FONT_LIMIT=0

# مجلد الكاش الذي ينزّل فيه setup_assets.py النماذج والخطوط (اختياري)
# ENGLISHAWY_CACHE=/path/to/cache

# مسار بديل لنموذج DINOv2 ONNX أو بيانات Tesseract (اختياري)
# DINOV2_ONNX_PATH=/path/to/dinov2_vits14.onnx
# TESSDATA_PREFIX=/path/to/tessdata

# عدد خيوط المعالج لنموذج DINOv2
DINOV2_THREADS=4
