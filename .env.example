# Englishawy v5 — example Space secrets / local .env
# Copy to .env locally. On Hugging Face: Settings -> Variables and secrets.

# --- Telegram (required for bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-16-chars-min
OWNER_TELEGRAM_ID=5231453921

# --- Cascade search (NEW in v5) ---
# Minimum external confidence (0..1) before falling back to the owner library.
CASCADE_THRESHOLD=0.78
# Free key from https://www.whatfontis.com/API-identify-fonts-from-image.html (after login)
WHATFONTIS_API_KEY=
# Only for MyFonts enterprise customers (no free public API). Without these,
# WhatTheFont is offered as a 1-click manual deep-link (still FIRST in order).
MYFONTS_API_KEY=
WHATTHEFONT_API_URL=

# --- Fonts / storage ---
ENGLISHAWY_DATA=/data/englishawy
ENGLISHAWY_PERSISTENT_STORAGE=1
# Optional: raise GitHub rate limits when downloading huge repos
GH_TOKEN=
# Optional local tuning
MAX_RESULTS=5
RERANK_CANDIDATES=30
FONT_LIMIT=0
